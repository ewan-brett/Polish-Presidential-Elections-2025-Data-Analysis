polpres <- polpres %>%
mutate(
total_r1 = Bartoszewicz + Biejat + Braun + Hołownia + Jakubiak +
Maciak + Mentzen + Nawrocki + Senyszyn +
Stanowski + Trzaskowski + Woch + Zandberg,
Biejat_p = Biejat / total_r1,
Zandberg_p = Zandberg / total_r1,
Holownia_p = Hołownia / total_r1,
Braun_p = Braun / total_r1,
Mentzen_p = Mentzen / total_r1)
polpres <- polpres %>%
